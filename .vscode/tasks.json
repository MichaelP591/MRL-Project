{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build RPLIDAR Project",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++11",
                "main.cpp",
                "-o", "main",
                "-I${workspaceFolder}/rplidar_sdk/sdk/include",
                "-L${workspaceFolder}/rplidar_sdk/sdk/src"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Builds the RPLIDAR project with correct includes and libraries"
        }
    ]
}